    "/api/candidates/{candidate_id}": {
      "patch": {
        "tags": [
          "candidates"
        ],
        "summary": "Correct Candidate",
        "operationId": "correct_candidate_api_candidates__candidate_id__patch",
        "parameters": [
          {
            "name": "candidate_id",
