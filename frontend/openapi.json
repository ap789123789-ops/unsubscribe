  "components": {
    "schemas": {
      "ActionPlanResponse": {
        "properties": {
          "id": {
            "type": "string",
            "title": "Id"
          },
          "digest": {
            "type": "string",
            "title": "Digest"
          },
          "confirmed": {
            "type": "boolean",
            "title": "Confirmed"
          },
          "items": {
            "items": {
              "$ref": "#/components/schemas/PlanItemResponse"
            },
            "type": "array",
            "title": "Items"
          }
        },
        "type": "object",
        "required": [
          "id",
          "digest",
          "confirmed",
          "items"
        ],
        "title": "ActionPlanResponse"
      },
      "CandidateCorrectionRequest": {
        "properties": {
          "category": {
            "$ref": "#/components/schemas/ClassificationCategory"
          },
          "expected_revision": {
            "type": "integer",
            "title": "Expected Revision"
          }
        },
        "type": "object",
        "required": [
          "category",
          "expected_revision"
        ],
        "title": "CandidateCorrectionRequest"
      },
      "CandidateListResponse": {
        "properties": {
          "items": {
            "items": {
              "$ref": "#/components/schemas/CandidateResponse"
            },
            "type": "array",
            "title": "Items"
          }
        },
        "type": "object",
        "required": [
          "items"
        ],
        "title": "CandidateListResponse"
      },
      "CandidateResponse": {
        "properties": {
          "id": {
            "type": "string",
            "title": "Id"
          },
          "revision": {
            "type": "integer",
            "title": "Revision"
          },
          "sender": {
            "type": "string",
            "title": "Sender"
          },
          "representative_subject": {
            "type": "string",
            "title": "Representative Subject"
          },
          "message_count": {
            "type": "integer",
            "title": "Message Count"
          },
          "category": {
            "$ref": "#/components/schemas/ClassificationCategory"
          },
          "confidence": {
            "type": "number",
            "title": "Confidence"
          },
          "reason": {
            "type": "string",
            "title": "Reason"
          },
          "evidence_quote": {
            "type": "string",
            "title": "Evidence Quote"
          },
          "method": {
            "type": "string",
            "title": "Method"
          },
          "target_display": {
            "type": "string",
            "title": "Target Display"
          },
          "first_seen": {
            "type": "string",
            "title": "First Seen"
          },
          "last_seen": {
            "type": "string",
            "title": "Last Seen"
          }
        },
        "type": "object",
        "required": [
          "id",
          "revision",
          "sender",
          "representative_subject",
          "message_count",
          "category",
          "confidence",
          "reason",
          "evidence_quote",
          "method",
          "target_display",
          "first_seen",
          "last_seen"
        ],
        "title": "CandidateResponse"
      },
      "ClassificationCategory": {
        "type": "string",
        "enum": [
          "marketing",
          "non_marketing",
          "unclear"
        ],
        "title": "ClassificationCategory"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "HealthResponse": {
        "properties": {
          "status": {
            "type": "string",
            "const": "ready",
            "title": "Status",
            "default": "ready"
          },
          "api_version": {
            "type": "string",
            "const": "v1",
            "title": "Api Version",
            "default": "v1"
          }
        },
        "type": "object",
        "title": "HealthResponse"
      },
      "OAuthCompleteResponse": {
        "properties": {
          "connected": {
            "type": "boolean",
            "title": "Connected",
            "default": true
          },
          "scopes": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Scopes"
          }
        },
        "type": "object",
        "required": [
          "scopes"
        ],
        "title": "OAuthCompleteResponse"
      },
      "OAuthStartResponse": {
        "properties": {
          "state": {
            "type": "string",
            "title": "State"
          },
          "authorization_url": {
            "type": "string",
            "title": "Authorization Url"
          }
        },
        "type": "object",
        "required": [
          "state",
          "authorization_url"
        ],
        "title": "OAuthStartResponse"
      },
      "PlanCreateRequest": {
        "properties": {
          "selections": {
            "items": {
              "$ref": "#/components/schemas/SelectionRequest"
            },
            "type": "array",
            "maxItems": 500,
            "minItems": 1,
            "title": "Selections"
          }
        },
        "type": "object",
        "required": [
          "selections"
        ],
        "title": "PlanCreateRequest"
      },
      "PlanItemResponse": {
        "properties": {
          "candidate_id": {
            "type": "string",
            "title": "Candidate Id"
          },
          "revision": {
            "type": "integer",
            "title": "Revision"
          },
          "sender": {
            "type": "string",
            "title": "Sender"
          },
          "subject": {
            "type": "string",
            "title": "Subject"
          },
          "method": {
            "type": "string",
            "title": "Method"
          },
          "target_display": {
            "type": "string",
            "title": "Target Display"
          }
        },
        "type": "object",
        "required": [
          "candidate_id",
          "revision",
          "sender",
          "subject",
          "method",
          "target_display"
        ],
        "title": "PlanItemResponse"
      },
      "ScanCreateRequest": {
        "properties": {
          "scan_id": {
            "type": "string",
            "maxLength": 100,
            "minLength": 1,
            "title": "Scan Id"
          },
          "days": {
            "type": "integer",
            "maximum": 365.0,
            "minimum": 1.0,
            "title": "Days",
            "default": 30
          },
          "max_messages": {
            "type": "integer",
            "maximum": 500.0,
            "minimum": 1.0,
            "title": "Max Messages",
            "default": 500
          }
        },
        "type": "object",
        "required": [
          "scan_id"
        ],
        "title": "ScanCreateRequest"
      },
      "ScanResponse": {
        "properties": {
          "scan_id": {
            "type": "string",
            "title": "Scan Id"
          },
          "processed_count": {
            "type": "integer",
            "title": "Processed Count"
          },
          "completed": {
            "type": "boolean",
            "title": "Completed"
          }
        },
        "type": "object",
        "required": [
          "scan_id",
          "processed_count",
          "completed"
        ],
        "title": "ScanResponse"
      },
      "SelectionRequest": {
        "properties": {
          "candidate_id": {
            "type": "string",
            "title": "Candidate Id"
          },
          "revision": {
            "type": "integer",
            "minimum": 1.0,
            "title": "Revision"
          }
        },
        "type": "object",
        "required": [
          "candidate_id",
          "revision"
        ],
        "title": "SelectionRequest"
      },
      "SessionResponse": {
        "properties": {
          "csrf_token": {
            "type": "string",
            "title": "Csrf Token"
          }
        },
        "type": "object",
        "required": [
          "csrf_token"
        ],
        "title": "SessionResponse"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          },
          "input": {
            "title": "Input"
          },
          "ctx": {
            "type": "object",
            "title": "Context"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      },
      "VerificationResponse": {
        "properties": {
          "verified": {
            "type": "boolean",
            "title": "Verified",
            "default": true
          }
        },
        "type": "object",
        "title": "VerificationResponse"
      }
    }
  }
}
