APP_ENV=development
APP_ENABLE_EXTERNAL_SERVICES=true
APP_HOST=127.0.0.1
APP_PORT=8000
APP_DATABASE_URL=sqlite:///./unsubscribe.db
# Optional: override the default project-local .local/logs/unsubscribe.log path and rotation.
# APP_LOG_FILE=/absolute/path/to/unsubscribe.log
# APP_LOG_MAX_BYTES=1000000
# APP_LOG_BACKUP_COUNT=3
OPENAI_API_KEY=
APP_GOOGLE_CLIENT_SECRETS_FILE=
# Real release smoke only; leave unset during normal development.
# Export UNSUBSCRIBE_SMOKE_EXPECTED_GMAIL and optional UNSUBSCRIBE_SMOKE_GMAIL_QUERY
# in the terminal before running the safe read/classification smoke.
# UNSUBSCRIBE_REAL_SMOKE_ACK=I_UNDERSTAND_THIS_SENDS_REAL_UNSUBSCRIBE_REQUESTS
# UNSUBSCRIBE_SMOKE_EXPECTED_GMAIL=your-test-account@example.com
# UNSUBSCRIBE_SMOKE_RFC_URL=https://controlled.example/one-click
# UNSUBSCRIBE_SMOKE_MAILTO=mailto:controlled@example.com?subject=Unsubscribe
# UNSUBSCRIBE_SMOKE_BROWSER_URL=https://controlled.example/browser
